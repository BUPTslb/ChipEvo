{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RankedSubtreeList",
  "type": "object",
  "required": ["design", "version", "top_k", "subtrees", "granularity_policy"],
  "properties": {
    "design": { "type": "string" },
    "version": { "type": "string" },
    "top_k": { "type": "integer" },
    "granularity_policy": {
      "type": "object",
      "properties": {
        "default_mutation_levels": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "L5 assignment-slice, L6 expression"
        },
        "rank_pool_level": {
          "type": "integer",
          "description": "Current pipeline ranks L2 process containers"
        },
        "rank_offset": { "type": "integer" }
      }
    },
    "weights": {
      "type": "object",
      "properties": {
        "min_slack": { "type": "number" },
        "path_coverage": { "type": "number" },
        "fanout_proxy": { "type": "number" },
        "pattern_amenability": { "type": "number" }
      }
    },
    "subtrees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "score", "span", "level", "write_set", "mutable"],
        "properties": {
          "id": { "type": "string" },
          "score": { "type": "number" },
          "level": { "type": "integer", "minimum": 1, "maximum": 7 },
          "kind": { "type": "string" },
          "min_slack": { "type": "number" },
          "path_coverage": { "type": "number" },
          "fanout_proxy": { "type": "number" },
          "span": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "start_line": { "type": "integer" },
              "end_line": { "type": "integer" },
              "ast_type": { "type": "string" },
              "block_id": { "type": "string" },
              "procedure_kind": { "type": "string" }
            }
          },
          "read_set": { "type": "array", "items": { "type": "string" } },
          "write_set": { "type": "array", "items": { "type": "string" } },
          "semantic_tag": { "type": "string" },
          "risk_level": { "type": "integer", "minimum": 1, "maximum": 5 },
          "mutable": { "type": "boolean" },
          "mutation_guidance": { "type": "string" },
          "signals": { "type": "array", "items": { "type": "string" } },
          "pattern_candidates": {
            "type": "array",
            "items": { "type": "string" }
          },
          "parent_id": { "type": ["string", "null"] }
        }
      }
    }
  }
}
