{
  "source": "DR_RTL/CLAUDE.md",
  "formula": "score = 0.5 * WNS_norm + 0.35 * TNS_norm + 0.15 * Area_norm + penalty",
  "normalization": {
    "WNS_norm": "(WNS - WNS_baseline) / abs(WNS_baseline)",
    "TNS_norm": "(TNS - TNS_baseline) / abs(TNS_baseline)",
    "Area_norm": "(Area - Area_baseline) / Area_baseline"
  },
  "penalty": {
    "condition": "Area_norm > 0.10",
    "value": 0.5
  },
  "direction": "lower_is_better",
  "baseline_version": "v0"
}
