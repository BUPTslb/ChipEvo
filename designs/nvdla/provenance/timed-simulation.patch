+static void eval_settle(VNV_nvdla* d) {
+    d->eval();
+    while (d->eventsPending()) {
+        Verilated::timeInc(d->nextTimeSlot() - Verilated::time());
+        d->eval();
+    }
+    Verilated::timeInc(1000);
+}
