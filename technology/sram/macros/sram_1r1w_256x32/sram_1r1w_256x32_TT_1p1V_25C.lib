                   "0.021, 0.631, 0.033, 0.07",\
                   "0.021, 0.631, 0.033, 0.07");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk0"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.016, -0.016, -0.04, -0.065",\
                   "-0.016, -0.016, -0.04, -0.065",\
                   "-0.016, -0.016, -0.04, -0.065",\
                   "-0.016, -0.016, -0.04, -0.065");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.016, -0.016, -0.016, -0.028",\
                   "-0.016, -0.016, -0.016, -0.028",\
                   "-0.016, -0.016, -0.016, -0.028",\
                   "-0.016, -0.016, -0.016, -0.028");
            }
        }
    }

    pin(clk0){
        clock             : true;
        direction  : input; 
        capacitance : 0.00020910000000000001;  
        internal_power(){
            when : "!csb0"; 
            rise_power(scalar){
                values("2.022963e+00");
            }
            fall_power(scalar){
                values("2.754537e+00");
            }
        }
        internal_power(){
            when : "csb0"; 
            rise_power(scalar){
                values("6.811086e-01");
            }
            fall_power(scalar){
                values("1.180995e+00");
            }
        }
        timing(){ 
            timing_type : "min_pulse_width"; 
            related_pin  : clk0; 
            rise_constraint(scalar) {
                values("0.6445"); 
            }
            fall_constraint(scalar) {
                values("0.6445"); 
            }
         }
        timing(){ 
            timing_type : "minimum_period"; 
            related_pin  : clk0; 
            rise_constraint(scalar) {
                values("1.289"); 
            }
            fall_constraint(scalar) {
                values("1.289"); 
            }
         }
    }

    bus(dout1){
        bus_type  : data; 
        direction  : output; 
        max_capacitance : 0.013382400000000001;  
        min_capacitance : 0.00020910000000000001;  
        memory_read(){ 
            address : addr1; 
        }
        pin(dout1[31:0]){
        timing(){ 
            timing_sense : non_unate; 
            related_pin : "clk1"; 
            timing_type : falling_edge; 
            cell_rise(CELL_TABLE) {
            values("0.44, 0.442, 0.449, 0.472",\
                   "0.441, 0.443, 0.45, 0.473",\
                   "0.444, 0.446, 0.453, 0.475",\
                   "0.444, 0.446, 0.453, 0.476");
            }
            cell_fall(CELL_TABLE) {
            values("0.44, 0.442, 0.449, 0.472",\
                   "0.441, 0.443, 0.45, 0.473",\
                   "0.444, 0.446, 0.453, 0.475",\
                   "0.444, 0.446, 0.453, 0.476");
            }
            rise_transition(CELL_TABLE) {
            values("0.026, 0.027, 0.035, 0.067",\
                   "0.026, 0.027, 0.035, 0.067",\
                   "0.025, 0.028, 0.035, 0.066",\
                   "0.025, 0.028, 0.035, 0.066");
            }
            fall_transition(CELL_TABLE) {
            values("0.026, 0.027, 0.035, 0.067",\
                   "0.026, 0.027, 0.035, 0.067",\
                   "0.025, 0.028, 0.035, 0.066",\
                   "0.025, 0.028, 0.035, 0.066");
            }
        }
        }
    }

    bus(addr1){
        bus_type  : addr; 
        direction  : input; 
        capacitance : 0.00020910000000000001;  
        max_transition       : 0.32;
        pin(addr1[7:0]){
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk1"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.033, 0.033, 0.033, 0.07",\
                   "0.033, 0.033, 0.033, 0.07",\
                   "0.033, 0.033, 0.033, 0.07",\
                   "0.033, 0.033, 0.033, 0.07");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.021, 0.631, 0.033, 0.07",\
                   "0.021, 0.631, 0.033, 0.07",\
                   "0.021, 0.631, 0.033, 0.07",\
                   "0.021, 0.631, 0.033, 0.07");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk1"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.016, -0.016, -0.04, -0.065",\
                   "-0.016, -0.016, -0.04, -0.065",\
                   "-0.016, -0.016, -0.04, -0.065",\
                   "-0.016, -0.016, -0.04, -0.065");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.016, -0.016, -0.016, -0.028",\
                   "-0.016, -0.016, -0.016, -0.028",\
                   "-0.016, -0.016, -0.016, -0.028",\
                   "-0.016, -0.016, -0.016, -0.028");
            }
        }
        }
    }

    pin(csb1){
        direction  : input; 
        capacitance : 0.00020910000000000001;  
        timing(){ 
            timing_type : setup_rising; 
            related_pin  : "clk1"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("0.033, 0.033, 0.033, 0.07",\
                   "0.033, 0.033, 0.033, 0.07",\
                   "0.033, 0.033, 0.033, 0.07",\
                   "0.033, 0.033, 0.033, 0.07");
            }
            fall_constraint(CONSTRAINT_TABLE) {
            values("0.021, 0.631, 0.033, 0.07",\
                   "0.021, 0.631, 0.033, 0.07",\
                   "0.021, 0.631, 0.033, 0.07",\
                   "0.021, 0.631, 0.033, 0.07");
            }
        }
        timing(){ 
            timing_type : hold_rising; 
            related_pin  : "clk1"; 
            rise_constraint(CONSTRAINT_TABLE) {
            values("-0.016, -0.016, -0.04, -0.065",\
                   "-0.016, -0.016, -0.04, -0.065",\
                   "-0.016, -0.016, -0.04, -0.065",\
                   "-0.016, -0.016, -0.04, -0.065");
              }
            fall_constraint(CONSTRAINT_TABLE) {
            values("-0.016, -0.016, -0.016, -0.028",\
                   "-0.016, -0.016, -0.016, -0.028",\
                   "-0.016, -0.016, -0.016, -0.028",\
                   "-0.016, -0.016, -0.016, -0.028");
            }
        }
    }

    pin(clk1){
        clock             : true;
        direction  : input; 
        capacitance : 0.00020910000000000001;  
        internal_power(){
            when : "!csb1"; 
            rise_power(scalar){
                values("2.118116e+00");
            }
            fall_power(scalar){
                values("2.027297e+00");
            }
        }
        internal_power(){
            when : "csb1"; 
            rise_power(scalar){
                values("5.353970e-01");
            }
            fall_power(scalar){
                values("5.630646e-01");
            }
        }
        timing(){ 
            timing_type : "min_pulse_width"; 
            related_pin  : clk1; 
            rise_constraint(scalar) {
                values("0.6445"); 
            }
            fall_constraint(scalar) {
                values("0.6445"); 
            }
         }
        timing(){ 
            timing_type : "minimum_period"; 
            related_pin  : clk1; 
